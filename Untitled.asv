clc; clear; close all;

%% ================== 母材数据 ==================

% 平面
plane = [-0.999322, -0.0362088, -0.0066518, 960.474];

% 圆柱
C = [988.462, -131.851, -25.7489];
axis_dir = [-0.509355, 0.86045, 0.0135688];
axis_dir = axis_dir / norm(axis_dir);
cyl_radius = 56.8793;

%% ================== 焊缝轨迹 ==================

% seam 0
seam{1} = [
    966.057, -140.87, 25.9319, -152.51, -51.9375, -22.5674;
    967.222, -171.199, 15.975, -128.729, -48.8545, -45.0217;
    968.306, -197.957, -1.23276, -104.473, -22.6581, -68.583;
    968.945, -210.387, -29.5118, 91.9003, -23.243, -74.4308;
];

% seam 1
seam{2} = [
    966.057, -140.87, 25.9319, -162.027, -54.9026, -10.7349;
    964.88, -109.305, 30.8759, -175.64, -48.9587, 0.644695;
    963.719, -77.3644, 31.5746, 174.358, -41.8905, 7.77142;
    962.592, -45.6156, 28.0329, 165.314, -33.8873, 12.7102;
    961.534, -14.8505, 19.4913, 154.586, -24.2627, 16.7449;
    960.637, 12.8001, 3.72238, 138.362, -17.6232, 12.2897;
];

%% ================== 焊枪参数 ==================

tool_radius = 10;     % 半径
tool_length = 100;    % 长度
offset = 15;          % 后撤（10mm焊丝 + 5mm）

%% ================== 画布 ==================

figure('Color','w');
hold on; axis equal;
xlabel('X'); ylabel('Y'); zlabel('Z');
view(3); grid on;

%% ================== 画平面 ==================

[xp, yp] = meshgrid(900:20:1000, -250:20:50);
zp = (-plane(1)*xp - plane(2)*yp - plane(4)) / plane(3);

surf(xp, yp, zp, ...
    'FaceAlpha',0.3, 'EdgeColor','none', 'FaceColor','cyan');

%% ================== 画圆柱母材 ==================

[theta, h] = meshgrid(linspace(0,2*pi,50), linspace(-120,120,50));
x = cyl_radius*cos(theta);
y = cyl_radius*sin(theta);
z = h;

% 构造局部坐标系
z_axis = axis_dir;
tmp = [1 0 0];
if abs(dot(tmp,z_axis)) > 0.9
    tmp = [0 1 0];
end

x_axis = cross(tmp,z_axis); x_axis = x_axis/norm(x_axis);
y_axis = cross(z_axis,x_axis);

R_cyl = [x_axis(:), y_axis(:), z_axis(:)];

pts = R_cyl * [x(:)'; y(:)'; z(:)'];

Xc = reshape(pts(1,:), size(x)) + C(1);
Yc = reshape(pts(2,:), size(y)) + C(2);
Zc = reshape(pts(3,:), size(z)) + C(3);

surf(Xc, Yc, Zc, ...
    'FaceAlpha',0.2, 'EdgeColor','none', 'FaceColor','green');

%% ================== 主循环 ==================

for s = 1:length(seam)

    poses = seam{s};
    prevZ = [];

    for i = 1:size(poses,1)

        %% ===== 当前点 =====
        P = poses(i,1:3);

        %% ===== 欧拉角 → 旋转矩阵 (ZYX) =====
        a = deg2rad(poses(i,4));
        b = deg2rad(poses(i,5));
        c = deg2rad(poses(i,6));

        Rz = [cos(a) -sin(a) 0;
              sin(a) cos(a)  0;
              0      0       1];

        Ry = [cos(b) 0 sin(b);
              0      1 0;
              -sin(b) 0 cos(b)];

        Rx = [1 0 0;
              0 cos(c) -sin(c);
              0 sin(c) cos(c)];

        R = Rz * Ry * Rx;

        Z = R(:,3);

%% ===== Z轴 =====
Z = R(:,3);

%% ? 约束1：必须朝世界 -Z
if dot(Z, [0 0 1]) > 0
    Z = -Z;
    R(:,1) = -R(:,1);
    R(:,2) = -R(:,2);
    R(:,3) = -R(:,3);
end

%% ? 约束2：防止跳变（连续性）
if ~isempty(prevZ)
    if dot(Z, prevZ) < 0
        Z = -Z;
        R(:,1) = -R(:,1);
        R(:,2) = -R(:,2);
        R(:,3) = -R(:,3);
    end
end

prevZ = Z;

        %% ===== 焊枪起点（后撤）=====
        base = P - offset * Z';

        %% ===== 构造焊枪圆柱 =====
        [th, hh] = meshgrid(linspace(0,2*pi,25), linspace(0,tool_length,25));

        x = tool_radius * cos(th);
        y = tool_radius * sin(th);
        z = -hh;

        pts = R * [x(:)'; y(:)'; z(:)'];

        X = reshape(pts(1,:), size(x)) + base(1);
        Y = reshape(pts(2,:), size(y)) + base(2);
        Zm = reshape(pts(3,:), size(z)) + base(3);

        %% ================== 干涉检测 ==================

        % --- 平面 ---
        dist_plane = abs(plane(1)*X + plane(2)*Y + plane(3)*Zm + plane(4)) ...
                     / norm(plane(1:3));

        collide_plane = any(dist_plane(:) < tool_radius);

        % --- 圆柱 ---
        CP = [X(:)-C(1), Y(:)-C(2), Zm(:)-C(3)];
        proj = (CP * axis_dir') .* axis_dir;
        radial = CP - proj;
        dist_cyl = sqrt(sum(radial.^2,2));

        collide_cyl = any(dist_cyl < cyl_radius);

        %% ================== 画图 ==================

        if collide_plane || collide_cyl
            color = 'r';   % 干涉
        else
            color = 'b';   % 正常
        end

        surf(X, Y, Zm, ...
            'FaceColor',color, 'EdgeColor','none', 'FaceAlpha',0.6);

        %% ===== 轨迹点 =====
        plot3(P(1),P(2),P(3),'ko','MarkerFaceColor','k');

        %% ===== 焊枪方向 =====
        quiver3(P(1),P(2),P(3), ...
                Z(1),Z(2),Z(3), ...
                30, 'k', 'LineWidth',1.5);

    end
end

title('焊枪轨迹 + 干涉检测（完整修正版）');