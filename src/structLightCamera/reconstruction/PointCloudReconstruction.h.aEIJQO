#ifndef POINTCLOUDRECONSTRUCTION_H
#define POINTCLOUDRECONSTRUCTION_H

#include <pcl/common/transforms.h>
#include <pcl/filters/extract_indices.h>
#include <pcl/io/pcd_io.h>
#include <pcl/kdtree/kdtree_flann.h>
#include <pcl/point_cloud.h>
#include <pcl/point_types.h>
#include <pcl/sample_consensus/ransac.h>
#include <pcl/sample_consensus/sac_model_plane.h>
#include <plog/Log.h>

#include <Eigen/Core>
#include <Eigen/Dense>
#include <array>
#include <cmath>
#include <iostream>
#include <memory>
#include <opencv2/opencv.hpp>

class StructLightConfig;
class WeldSeamInfo;

class PointCloudReconstruction {
public:
    PointCloudReconstruction();

    pcl::PointCloud<pcl::PointXYZ>::Ptr globalReconstruct();           // 全局点云重建
    std::vector<std::shared_ptr<WeldSeamInfo>> weldAreaReconstruct();  // 焊缝区域点云重建

    void re_initialize();  //  变量重新初始化

    void imageDistribution();        // 将采集到的图像放入相移和格雷码容器
    void MaskFor_UpdateWorkbench();  // 1.更新背景平面的mask设置
    void solve_wrapped_phase();      // 2.相移法求包裹相位
    void decode_Graycode();          // 3.解码格雷码
    void phase_unwrapping();         // 4.相位展开，求绝对相位

    void Reconstruction_ForWorkbenche(pcl::PointCloud<pcl::PointXYZ>::Ptr points);  // 5.背景平面的三维重建，拟合背景平面参数

private:
    // 计算过程中需要用到的参数
    StructLightConfig& structLightConfig;
    const double myPi = 3.1415926535897932384626433832795;
    const int img_width = 1600;  // 相机分辨率
    const int img_height = 1200;
    const int pro_width = 1280;  // 投影仪分辨率
    const int pro_height = 720;
    static const int Step_N = 12;     // 相移步数
    int Gary_total_image_num = 9;     // 格雷码总图片数, 6+2+1=9
    int Gary_encode_image_num = 6;    // 传统格雷码编解码的图像数量
    double modulation_threshold = 2;  // 调制度阈值
    double RansacPlane_dTh = 2;       // Ransac拟合背景平面的距离阈值
    cv::Mat dist_camera;              // 畸变系数集合 Opencv: k1, k2, p1, p2, k3
    cv::Mat dist_project;             // 畸变系数集合 Opencv: k1, k2, p1, p2, k3
    double sinTable[Step_N];          // sin表
    double cosTable[Step_N];          // cos表

    // 计算过程中需要用到的类

    // 计算前采集到的数据
    std::shared_ptr<std::vector<cv::Mat>> primaryCameraCapturedImg{nullptr};    // 主相机采集到的图像
    std::shared_ptr<std::vector<cv::Mat>> secondaryCameraCapturedImg{nullptr};  // 次相机采集到的图像
    std::vector<cv::Mat> phase_shift_images;                                    // 相移图集合
    std::vector<cv::Mat> gray_code_images;                                      // 格雷码图集合

    // 计算过程的中间量
    cv::Mat sin_sum = cv::Mat::zeros(img_height, img_width, CV_64FC1);                    // sin和
    cv::Mat cos_sum = cv::Mat::zeros(img_height, img_width, CV_64FC1);                    // cos和
    cv::Mat pha_wrapped = cv::Mat::zeros(img_height, img_width, CV_64FC1);                // 包裹相位
    cv::Mat B_modulation = cv::Mat::zeros(img_height, img_width, CV_64FC1);               // 调制度
    cv::Mat K1 = cv::Mat::zeros(img_height, img_width, CV_8UC1);                          // 每一像素的K1
    cv::Mat K2 = cv::Mat::zeros(img_height, img_width, CV_8UC1);                          // 每一像素的K2
    cv::Mat Threshold_Graycode = cv::Mat::zeros(img_height, img_width, CV_64FC1);         // 每一像素的二值化阈值
    cv::Mat pha_absolute = cv::Mat::zeros(img_height, img_width, CV_64FC1);               // 绝对相位
    cv::Mat unDistortion_pha_absolute = cv::Mat::zeros(img_height, img_width, CV_64FC1);  // 去除相机畸变后的绝对相位
    cv::Mat maskForReconstruct = cv::Mat::zeros(img_height, img_width, CV_8UC1);          // 深度学习目标框掩模
    cv::Mat maskForWorkbench = cv::Mat::zeros(img_height, img_width, CV_8UC1);            // 用于工作台重建的掩模

    // 计算结果
    Eigen::VectorXf WorkPlane_coeff = Eigen::VectorXf::Ones(4);  // 工作台的背景平面参数

    // clang-format off
    std::map<uchar, uchar> VK1 {  // 格雷码对应表
        {0,  0 }, {1,  1 }, {3,  2 }, {2,  3 }, {6,  4 }, {7,  5 }, {5,  6 }, {4,  7 },
        {12, 8 }, {13, 9 }, {15, 10}, {14, 11}, {10, 12}, {11, 13}, {9,  14}, {8,  15},
        {24, 16}, {25, 17}, {27, 18}, {26, 19}, {30, 20}, {31, 21}, {29, 22}, {28, 23},
        {20, 24}, {21, 25}, {23, 26}, {22, 27}, {18, 28}, {19, 29}, {17, 30}, {16, 31},
        {48, 32}, {49, 33}, {51, 34}, {50, 35}, {54, 36}, {55, 37}, {53, 38}, {52, 39},
        {60, 40}, {61, 41}, {63, 42}, {62, 43}, {58, 44}, {59, 45}, {57, 46}, {56, 47},
        {40, 48}, {41, 49}, {43, 50}, {42, 51}, {46, 52}, {47, 53}, {45, 54}, {44, 55},
        {36, 56}, {37, 57}, {39, 58}, {38, 59}, {34, 60}, {35, 61}, {33, 62}, {32, 63}
    };
    std::map<uchar, uchar> VK2 {  // 互补格雷码对应表
        {0,   0 }, {1,   1 }, {3,   1 }, {2,   2 }, {6,   2 }, {7,   3 }, {5,   3 }, {4,   4 },
        {12,  4 }, {13,  5 }, {15,  5 }, {14,  6 }, {10,  6 }, {11,  7 }, {9,   7 }, {8,   8 },
        {24,  8 }, {25,  9 }, {27,  9 }, {26,  10}, {30,  10}, {31,  11}, {29,  11}, {28,  12},
        {20,  12}, {21,  13}, {23,  13}, {22,  14}, {18,  14}, {19,  15}, {17,  15}, {16,  16},
        {48,  16}, {49,  17}, {51,  17}, {50,  18}, {54,  18}, {55,  19}, {53,  19}, {52,  20},
        {60,  20}, {61,  21}, {63,  21}, {62,  22}, {58,  22}, {59,  23}, {57,  23}, {56,  24},
        {40,  24}, {41,  25}, {43,  25}, {42,  26}, {46,  26}, {47,  27}, {45,  27}, {44,  28},
        {36,  28}, {37,  29}, {39,  29}, {38,  30}, {34,  30}, {35,  31}, {33,  31}, {32,  32},
        {96,  32}, {97,  33}, {99,  33}, {98,  34}, {102, 34}, {103, 35}, {101, 35}, {100, 36},
        {108, 36}, {109, 37}, {111, 37}, {110, 38}, {106, 38}, {107, 39}, {105, 39}, {104, 40},
        {120, 40}, {121, 41}, {123, 41}, {122, 42}, {126, 42}, {127, 43}, {125, 43}, {124, 44},
        {116, 44}, {117, 45}, {119, 45}, {118, 46}, {114, 46}, {115, 47}, {113, 47}, {112, 48},
        {80,  48}, {81,  49}, {83,  49}, {82,  50}, {86,  50}, {87,  51}, {85,  51}, {84,  52},
        {92,  52}, {93,  53}, {95,  53}, {94,  54}, {90,  54}, {91,  55}, {89,  55}, {88,  56},
        {72,  56}, {73,  57}, {75,  57}, {74,  58}, {78,  58}, {79,  59}, {77,  59}, {76,  60},
        {68,  60}, {69,  61}, {71,  61}, {70,  62}, {66,  62}, {67,  63}, {65,  63}, {64,  64}
    };
    // clang-format on

    friend class StructLightCamera;
};

#endif  // POINTCLOUDRECONSTRUCTION_H
