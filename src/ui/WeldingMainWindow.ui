      <property name="styleSheet">
       <string notr="true">QTabWidget::pane {  /* 标签页内容区域 */
    border: 2px solid #b4b4b4;
    border-radius: 6px;
    background: #f6f6f6;
    margin-top: 0px; /* 与标签栏重叠边框 */
}

QTabWidget::tab-bar {  /* 标签栏整体 */
    left: 0px; /* 标题左侧留空（类似QGroupBox的title缩进） */
}

QTabBar::tab {  /* 单个标签页 */
    background: #d0d0d0;
    border: 2px solid #b4b4b4;
    border-bottom: none; /* 隐藏底部边框（与pane区域衔接） */
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #000000;
    padding: 5px 15px; /* 标签内边距 */
    margin-right: 2px; /* 标签间距 */
}

QTabBar::tab:selected {  /* 选中的标签页 */
    background: #f6f6f6; /* 与pane区域背景一致 */
    border-bottom: 2px solid #f6f6f6; /* 覆盖pane的上边框 */
}

QTabBar::tab:!selected {  /* 未选中的标签页 */
    margin-top: 3px; /* 模拟QGroupBox的margin-top */
}</string>
